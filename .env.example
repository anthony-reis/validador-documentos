# Copie para .env e ajuste. Nunca commitar o .env real.

# --- Restricao offline (obrigatorio, ver CLAUDE.md) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Caminhos ---
DATA_NORMAS_DIR=data/normas
DATA_DOCUMENTOS_TESTE_DIR=data/documentos_teste
MODELS_DIR=models
CHROMA_PERSIST_DIR=chroma_db
BM25_INDEX_DIR=bm25_index

# --- Modelos locais ---
EMBEDDING_MODEL_PATH=models/bge-m3
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3

# --- LLM via Ollama ---
# Fixar a tag exata (incl. quantizacao). NAO usar "qwen2.5" sem tag: a
# quantizacao muda o resultado e quebra a reprodutibilidade dos experimentos.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Chunking (parametrizavel -- variavel de experimento, ver CLAUDE.md) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Recuperacao ---
RETRIEVAL_TOP_K=5
# Limiar de score abaixo do qual o veredito e' INDETERMINADO por abstençao.
# Nao ha valor "certo" a priori -- calibrar experimentalmente e registrar
# a justificativa (ver CLAUDE.md: nenhum numero de desempenho e' inventado).
RETRIEVAL_SCORE_THRESHOLD=0.0
RETRIEVAL_POOL_SIZE=20
RRF_K=60
